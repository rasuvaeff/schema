{
    "symbol-whitelist": [
        "PhpParser\\Node\\Arg",
        "PhpParser\\Node\\Expr",
        "PhpParser\\Node\\Expr\\Array_",
        "PhpParser\\Node\\Expr\\MethodCall",
        "PhpParser\\Node\\Identifier",
        "PhpParser\\Node\\Scalar\\String_",
        "Psalm\\Plugin\\EventHandler\\Event\\MethodReturnTypeProviderEvent",
        "Psalm\\Plugin\\EventHandler\\MethodReturnTypeProviderInterface",
        "Psalm\\Plugin\\PluginEntryPointInterface",
        "Psalm\\Plugin\\RegistrationInterface",
        "Psalm\\StatementsSource",
        "Psalm\\Type",
        "Psalm\\Type\\Atomic\\TArray",
        "Psalm\\Type\\Atomic\\TEnumCase",
        "Psalm\\Type\\Atomic\\TGenericObject",
        "Psalm\\Type\\Atomic\\TKeyedArray",
        "Psalm\\Type\\Atomic\\TNamedObject",
        "Psalm\\Type\\Union",
        "Yiisoft\\Validator\\Exception\\UnexpectedRuleException",
        "Yiisoft\\Validator\\Result",
        "Yiisoft\\Validator\\RuleHandlerInterface",
        "Yiisoft\\Validator\\RuleInterface",
        "Yiisoft\\Validator\\Rule\\Trait\\SkipOnEmptyTrait",
        "Yiisoft\\Validator\\Rule\\Trait\\SkipOnErrorTrait",
        "Yiisoft\\Validator\\Rule\\Trait\\WhenTrait",
        "Yiisoft\\Validator\\SkipOnEmptyInterface",
        "Yiisoft\\Validator\\SkipOnErrorInterface",
        "Yiisoft\\Validator\\ValidationContext",
        "Yiisoft\\Validator\\WhenInterface"
    ],
    "php-core-extensions": [
        "Core",
        "date",
        "json",
        "pcre",
        "Reflection",
        "SPL",
        "random",
        "standard"
    ],
    "scan-files": []
}
